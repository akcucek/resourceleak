# Export these in your shell (the app reads environment variables; it does not load .env itself).
GOOGLE_MAPS_API_KEY=          # enables live Places counts (restrict key to Places API (New))
GEMINI_API_KEY=               # optional: Gemini extraction of waste logs
GOOGLE_CLOUD_PROJECT=         # with BQ_DATASET enables BigQuery export
BQ_DATASET=
GOOGLE_ACCESS_TOKEN=          # local dev only: gcloud auth print-access-token
OUTLET_ORDER_LIMIT_INR=9500
